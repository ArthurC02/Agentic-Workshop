{
  "format": "domain-memory-policy/v1",
  "storage_mode": "tracked",
  "data_classification": "internal",
  "review_mode": "local-draft-only",
  "review_governance": {
    "verifier": "none",
    "trigger": "none",
    "ci_requirement": "none",
    "authorized_signers": [],
    "distinct_signer": false
  },
  "source_policy": {
    "selected_paths": [
      "docs/adr",
      "docs/requirements",
      "src",
      "tests"
    ],
    "include": [
      "**"
    ],
    "exclude": [
      "**/__pycache__/**"
    ],
    "authority": "DLC Proposer <proposer@example.com>"
  },
  "limits": {
    "max_file_count": 10000,
    "max_file_bytes": 10485760,
    "max_total_bytes": 104857600,
    "max_query_results": 100
  },
  "schema_conventions": {
    "exempt_columns": [
      "id",
      "created_at",
      "updated_at"
    ],
    "status_like_suffixes": [
      "status",
      "state",
      "kind",
      "mode",
      "tier",
      "role",
      "decision",
      "verdict",
      "outcome",
      "phase",
      "stage",
      "level",
      "priority",
      "severity",
      "visibility",
      "category"
    ],
    "free_text_markers": [
      "free text",
      "free-text"
    ],
    "value_comment_limit": 12
  },
  "project_profile": {
    "implementation_roots": [
      "apps",
      "src",
      "services",
      "packages",
      "db",
      "database",
      "migrations",
      "schema"
    ],
    "excluded_directories": [],
    "decision_roots": [
      "docs/adr",
      "adr",
      "docs/architecture",
      "architecture"
    ],
    "boundary_markers": [
      "doc.go"
    ]
  },
  "approved_command_profiles": []
}
